{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Servidor Vite (pnpm dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frontend: Abrir en Chrome (debug)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src"
    },
    {
      "name": "Frontend: Abrir en Edge (debug)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src"
    }
  ],
  "compounds": [
    {
      "name": "Frontend: Vite + Chrome",
      "configurations": ["Frontend: Servidor Vite (pnpm dev)", "Frontend: Abrir en Chrome (debug)"],
      "stopAll": true
    }
  ]
}
