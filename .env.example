# URL de la API (nube o IP:puerto del host en modo LAN)
VITE_API_URL=http://localhost:3000/api/v1

# Módulos conectados al backend real, separados por coma (economia = M14, retos = M12).
# Vacío = todos con datos simulados.
VITE_API_MODULES=

# Solo desarrollo, mientras no exista el login (M00): _id de MongoDB del usuario de prueba.
# Para Economía (M14) debe ser un ADMIN: en el backend, "pnpm db:admin-prueba" imprime uno.
VITE_DEV_USER_ID=

# Habilitar solo cuando el backend implemente /api/v1/admin/host/* y /api/v1/admin/data/*
VITE_ADMIN_API_ENABLED=false

# Firebase Cloud Messaging
VITE_FCM_API_KEY=
VITE_FCM_PROJECT_ID=
VITE_FCM_SENDER_ID=
VITE_FCM_APP_ID=
VITE_FCM_VAPID_KEY=
